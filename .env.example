DEBUG=1
SECRET_KEY=change-me-in-every-environment
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production (DEBUG=0), behind a proxy that terminates TLS.
# Leave blank locally.
CSRF_TRUSTED_ORIGINS=
# Only needed in production, if the nightly worklog job runs via an HTTP
# endpoint hit by a scheduler instead of a standing Celery beat process.
# Leave blank locally — Celery beat (docker-compose.yml) does the job.
CADENCE_CRON_SECRET=

DATABASE_URL=postgres://cadence:cadence@postgres:5432/cadence
CELERY_BROKER_URL=redis://redis:6379/0
